# ============================================================================
# SLZ ERP — environment template. Copy to `.env` and adjust. NO REAL SECRETS.
# ============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-50-char-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=fa
DJANGO_TIME_ZONE=Asia/Tehran
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=slz_erp
POSTGRES_USER=slz_erp
POSTGRES_PASSWORD=slz_erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- API / CORS ---
API_PAGE_SIZE=25
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Documents ---
DOCUMENTS_MAX_UPLOAD_BYTES=26214400
DOCUMENTS_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,svg,ai,xlsx,docx,csv,txt,zip

# --- Bootstrap superuser (optional; used by seed_rbac) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
