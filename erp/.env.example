# ============================================================================
# SLZ ERP — environment template. NO REAL SECRETS.
# Development: cp .env.example .env and adjust.
# Production: run scripts/gen-env.sh (generates erp/.env with real random
# secrets) and deploy with docker-compose.prod.yml behind the Cloudflare
# Tunnel (see infrastructure/cloudflared/ and docs/VPS-DEPLOYMENT-HANDOFF.md).
# ============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-50-char-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=fa
DJANGO_TIME_ZONE=Asia/Tehran
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=slz_erp
POSTGRES_USER=slz_erp
POSTGRES_PASSWORD=slz_erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- API / CORS ---
API_PAGE_SIZE=25
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_THROTTLE_RATE=30/min

# --- Documents ---
DOCUMENTS_MAX_UPLOAD_BYTES=26214400
DOCUMENTS_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,svg,ai,xlsx,docx,csv,txt,zip

# --- Production-only overrides (used by docker-compose.prod.yml) ---
# The prod overlay requires DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS and
# POSTGRES_PASSWORD to be set (no fallbacks). gen-env.sh writes them with
# random values; CORS_ALLOWED_ORIGINS should be the https origin of the
# public domain.
# DJANGO_ALLOWED_HOSTS=slz.abystral.kdns.fr,localhost
# CORS_ALLOWED_ORIGINS=https://slz.abystral.kdns.fr
# SEED_RBAC_STRICT=true

# --- Bootstrap superuser (optional; used by seed_rbac) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
