# Base URL for the SLZ ERP backend API.
# The frontend appends resource paths (e.g. /auth/login/) to this value.
# Leave unset for same-origin `/api/v1` (recommended): the reverse proxy
# (nginx) routes /api/ to the backend. Only set an absolute URL if the API
# lives on a different origin.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
